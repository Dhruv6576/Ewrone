# Supabase Edge Functions Environment Template
# Copy to supabase/functions/.env for local development

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here
RAZORPAY_KEY_ID=your-razorpay-key-id-here
RAZORPAY_KEY_SECRET=your-razorpay-key-secret-here
INTERNAL_WORKER_SECRET=your-dedicated-internal-worker-secret-here
